{
  "workspaceRoot": "./workspace",
  "sessionStateRoot": "./session_state",

  "llm": {
    "provider": "mock",
    "timeoutMs": 180000,
    "maxRetries": 3,
    "backoffMs": [2000, 4000, 8000, 16000],
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKeyEnv": "OPENAI_API_KEY",
        "model": "gpt-4o",
        "jsonMode": true
      },
      "anthropic": {
        "baseUrl": "https://api.anthropic.com/v1",
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "model": "claude-opus-5",
        "version": "2023-06-01"
      },
      "mock": {
        "model": "mock-writer-1"
      }
    }
  },

  "context": {
    "windowTokens": 128000,
    "warnRatio": 0.5,
    "cacheRatio": 0.8,
    "hardResetRatio": 0.92,
    "autoResume": true
  },

  "quality": {
    "passScore": 82,
    "maxRevisions": 2,
    "minImprovementDelta": 3,
    "escalateOnStall": true
  },

  "guard": {
    "allowWriteOutsideWorkspace": false,
    "denyPathPatterns": [
      "^/etc/", "^/root/", "^/var/", "^/usr/", "^/bin/", "^/sbin/", "^/boot/",
      "(^|/)\\.ssh(/|$)", "(^|/)\\.aws(/|$)", "(^|/)\\.git(/|$)",
      "(^|/)\\.env(\\.|$)", "(^|/)id_rsa", "(^|/)node_modules(/|$)"
    ],
    "denyCommandPatterns": [
      "rm\\s+-rf\\s+/", "mkfs", "dd\\s+if=", ":\\(\\)\\{", "chmod\\s+-R\\s+777\\s+/",
      "git\\s+push", "curl[^|]*\\|\\s*(ba)?sh", "shutdown", "reboot"
    ],
    "secretPatterns": [
      "sk-[A-Za-z0-9_\\-]{16,}",
      "sk-ant-[A-Za-z0-9_\\-]{16,}",
      "gh[pousr]_[A-Za-z0-9]{20,}",
      "AKIA[0-9A-Z]{16}",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    ],
    "backupBeforeOverwrite": true,
    "maxWriteBytes": 4194304
  },

  "bus": {
    "maxAttempts": 3,
    "deadLetterOnExceed": true
  },

  "budget": {
    "maxAgentCalls": 200,
    "maxTotalTokens": 2000000
  }
}
